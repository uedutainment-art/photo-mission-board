rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isEventOwner(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
    }

    function isEventOwnerAfter(eventId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
    }

    function isCompletedEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.status == 'completed';
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    function hasParticipantSession(eventId, teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)/participantSessions/$(request.auth.uid)).data.teamId == teamId;
    }

    function isContestEvent(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      return 'modules' in eventData
        && 'photoContest' in eventData.modules
        && eventData.modules.photoContest == true;
    }

    function resultsPublished(eventId) {
      let eventData = get(/databases/$(database)/documents/events/$(eventId)).data;
      return 'results' in eventData
        && eventData.results.status == 'published'
        && 'voting' in eventData
        && eventData.voting.status == 'closed';
    }

    function isOwnTeamVote(eventId, voteId) {
      return signedIn()
        && voteId == 'team_' + get(/databases/$(database)/documents/events/$(eventId)/participantSessions/$(request.auth.uid)).data.teamId;
    }

    // Phase 5 의 useTeamSession 이 collectionGroup("teams") + where("token", "==", ...)
    // 으로 팀을 찾기 위해 필요한 collectionGroup matcher.
    // 일반 nested matcher 는 collectionGroup query 를 인식하지 못함.
    match /{path=**}/teams/{teamId} {
      allow read: if signedIn();
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /events/{eventId} {
      allow get: if signedIn()
        || resource.data.status == 'completed';
      allow list: if (signedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status == 'completed';
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isEventOwner(eventId);

      match /teams/{teamId} {
        allow read: if signedIn();
        allow create: if isEventOwnerAfter(eventId);
        allow delete: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || (signedIn() && changedOnly(['joinedMembers', 'status']));
      }

      match /accessCodes/{codeId} {
        allow read, update, delete: if isEventOwner(eventId);
        allow create: if isEventOwnerAfter(eventId);
      }

      match /participantSessions/{sessionId} {
        allow read: if signedIn()
          && (sessionId == request.auth.uid || isEventOwner(eventId));
        allow write: if false;
      }

      match /familySubmissions/{teamId} {
        allow read: if signedIn()
          || isCompletedEvent(eventId);
        allow create: if isEventOwner(eventId)
          || (
            hasParticipantSession(eventId, teamId)
            && get(/databases/$(database)/documents/events/$(eventId)).data.submission.status == 'open'
            && request.resource.data.eventId == eventId
            && request.resource.data.teamId == teamId
            && request.resource.data.uploaderId == request.auth.uid
            && request.resource.data.hidden == false
          );
        allow update: if isEventOwner(eventId)
          || (
            hasParticipantSession(eventId, teamId)
            && get(/databases/$(database)/documents/events/$(eventId)).data.submission.status == 'open'
            && request.resource.data.eventId == eventId
            && request.resource.data.teamId == teamId
            && request.resource.data.uploaderId == request.auth.uid
            && request.resource.data.hidden == resource.data.hidden
          );
        allow delete: if isEventOwner(eventId);
      }

      match /songRequests/{requestId} {
        allow read, update, delete: if isEventOwner(eventId);
        allow create: if signedIn()
          && request.resource.data.eventId == eventId
          && request.resource.data.requesterId == request.auth.uid;
      }

      match /slots/{slotId} {
        allow read: if signedIn()
          || isCompletedEvent(eventId);
        allow create: if isEventOwnerAfter(eventId);
        allow delete: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || (signedIn() && changedOnly(['submissionCount', 'representativePhotoId']));
      }

      match /photos/{photoId} {
        allow read: if signedIn()
          || isCompletedEvent(eventId);
        allow create: if signedIn()
          && request.resource.data.eventId == eventId;
        allow update: if signedIn()
          && (
            changedOnly(['isRepresentative'])
            || resource.data.uploaderId == request.auth.uid
            || isEventOwner(eventId)
          );
        allow delete: if signedIn()
          && (
            resource.data.uploaderId == request.auth.uid
            || isEventOwner(eventId)
          );
      }

      match /selfies/{selfieId} {
        allow read: if signedIn()
          || isCompletedEvent(eventId);
        allow create: if signedIn()
          && request.resource.data.eventId == eventId;
        allow update, delete: if signedIn()
          && (
            resource.data.uploaderId == request.auth.uid
            || isEventOwner(eventId)
          );
      }

      match /votes/{voteId} {
        allow read: if (!isContestEvent(eventId) && signedIn())
          || isEventOwner(eventId)
          || isCompletedEvent(eventId)
          || resultsPublished(eventId)
          || isOwnTeamVote(eventId, voteId);
        allow create: if !isContestEvent(eventId)
          && signedIn()
          && request.resource.data.eventId == eventId
          && request.resource.data.voterId == request.auth.uid;
        allow update: if !isContestEvent(eventId)
          && signedIn()
          && resource.data.voterId == request.auth.uid
          && request.resource.data.voterId == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.voterTeamId == resource.data.voterTeamId;
        allow delete: if !isContestEvent(eventId)
          && signedIn()
          && (
            resource.data.voterId == request.auth.uid
            || isEventOwner(eventId)
          );
      }
    }
  }
}
